modules = ["nodejs-24", "postgresql-16"]

[deployment]
deploymentTarget = "autoscale"
# Build the frontend first, then compile the API server.
# Express serves both /api/* and the built static files in production.
build = ["sh", "-c", "BASE_PATH=/ pnpm --filter @workspace/al-shaibia-admin run build && pnpm --filter @workspace/api-server run build"]
# Start Express on port 5000 (the single public-facing port).
run = ["sh", "-c", "PORT=5000 NODE_ENV=production node artifacts/api-server/dist/index.mjs"]

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/start-dev.sh"
waitForPort = 5000

[agent]
stack = "BEST_EFFORT_FALLBACK"
expertMode = true
integrations = ["javascript_log_in_with_replit:2.0.0", "javascript_database:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 20423
externalPort = 3000

[[ports]]
localPort = 23451
externalPort = 3002

[nix]
channel = "stable-25_05"

